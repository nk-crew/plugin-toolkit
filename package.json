		"url": "git+https://github.com/nk-crew/plugin-toolkit.git"
	},
	"exports": {
		"./biome": "./biome.json",
		"./stylelint": "./stylelint.js",
		"./lint-staged": "./lint-staged.js",
		"./playwright": "./playwright.js",
		"./env-ports": "./scripts/env-ports.js",
		"./package.json": "./package.json"
	},
	"bin": {
		"nk-activate-plugins": "./scripts/activate-plugin.js",
		"nk-env-ports": "./scripts/print-ports.js",
		"nk-worktree-setup": "./scripts/worktree-setup.sh",
		"nk-wp-env": "./scripts/wp-env.js"
	},
	"files": [
		"LICENSE",
		"biome.json",
		"lint-staged.js",
		"playwright.js",
		"scripts",
		"stylelint.js"
